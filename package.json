{
  "name": "ostad-webterminal",
  "private": true,
  "workspaces": ["server", "web"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace web\"",
    "build": "npm run build --workspace server && npm run build --workspace web",
    "lint": "eslint server/src web/src",
    "typecheck": "tsc -b server/tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run --config server/vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
